# 이 파일을 .env 로 복사해 값을 채운 뒤 S3 에 올린다 (git 에 올리지 않는다)
#   aws s3 cp .env s3://allbutyou-secrets-<ACCOUNT_ID>/config/.env
# 서버의 deploy 디렉터리에는 fetch-env.sh 가 이 파일을 .env 로 받아온다.

# 이미지 경로 ghcr.io/<GHCR_OWNER>/allbutyou-backend. 반드시 소문자
GHCR_OWNER=umc-itta-medilux-half-hackerton

# private 이미지 pull 용. Classic PAT(read:packages). 이미지를 public 으로 열면 비워도 된다
GHCR_USER=
GHCR_TOKEN=

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
